<div class="pane">
    <div class="toolkit-page-heading">
        <span class="toolkit-icon" aria-hidden="true">{{ iconSvg|raw }}</span>
        <h2>Streaming Video</h2>
    </div>
    <p class="light">Converts the videos you switch on to HLS (adaptive streaming, several qualities) in the queue, next to the original file in the same volume, and adds <code>hlsPlaylistUrl</code> and <code>videoPoster</code> to assets in GraphQL. The frontend plays it with hls.js and falls back to the original file while a video is encoding.</p>

    <div class="field">
        <div class="btngroup" role="tablist" aria-label="Streaming Video sections">
            <button type="button" class="btn streaming-video-tab active" data-tab="overview" role="tab" tabindex="0" aria-controls="streaming-video-panel-overview" aria-selected="true">Overview</button>
            <button type="button" class="btn streaming-video-tab" data-tab="settings" role="tab" tabindex="-1" aria-controls="streaming-video-panel-settings" aria-selected="false">Settings</button>
            <button type="button" class="btn streaming-video-tab" data-tab="costs" role="tab" tabindex="-1" aria-controls="streaming-video-panel-costs" aria-selected="false">Costs</button>
            <button type="button" class="btn streaming-video-tab" data-tab="help" role="tab" tabindex="-1" aria-controls="streaming-video-panel-help" aria-selected="false">Help</button>
        </div>
    </div>

    <div id="streaming-video-panel-overview" data-streaming-video-panel="overview" role="tabpanel">
        {% include "toolkit/utilities/streaming-video/_overview" %}
    </div>

    <div id="streaming-video-panel-settings" data-streaming-video-panel="settings" role="tabpanel" class="hidden">
        {% include "toolkit/utilities/streaming-video/_settings" %}
    </div>

    <div id="streaming-video-panel-costs" data-streaming-video-panel="costs" role="tabpanel" class="hidden">
        {% include "toolkit/utilities/streaming-video/_costs" %}
    </div>

    <div id="streaming-video-panel-help" data-streaming-video-panel="help" role="tabpanel" class="hidden">
        {% include "toolkit/utilities/streaming-video/_help" %}
    </div>
</div>
