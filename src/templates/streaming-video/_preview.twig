{# Same layout as Craft's own video preview, with the HLS stream and a quality menu over it #}
{% set height = asset.alt ? '70%' : '100%' %}

<div class="toolkit-hls-preview" style="height: {{ height }};">
    <video
        class="toolkit-hls-video"
        autoplay
        controls
        playsinline
        {% if posterUrl %}poster="{{ posterUrl }}"{% endif %}
    ></video>
    <div class="toolkit-quality-bar toolkit-quality-overlay" data-hls-src="{{ playlistUrl }}" data-original-src="{{ url }}" data-start="auto"></div>
</div>

{% if asset.alt %}
    <div class="video-transcript" tabindex="0" style="height: 30%;">
        <div class="video-transcript__inner">
            <h2 class="video-transcript__heading">{{ 'Transcript'|t('app') }}</h2>
            <p class="video-transcript__text">{{ asset.alt|nl2br }}</p>
        </div>
    </div>
{% endif %}
