{% import "_includes/forms" as forms %}

<div class="toolkit-streaming" data-asset-id="{{ asset.id }}"
    {%- if playlistUrl and url %} data-hls-src="{{ playlistUrl }}" data-original-src="{{ url }}"{% endif %}>
    {% if not envEnabled %}
        <p class="warning has-icon">
            <span class="icon" aria-hidden="true"></span>
            <span>Streaming is switched off on this environment (<code>{{ envVar }}</code>): nothing is encoded and the frontend plays the original file.</span>
        </p>
    {% endif %}

    <div class="toolkit-streaming-row">
        {{ forms.lightswitch({
            name: name ~ '[enabled]',
            on: value.enabled,
            label: 'Convert to HLS',
        }) }}
    </div>
    <p class="light toolkit-streaming-note">Adaptive streaming in several qualities, encoded in the queue after saving. Off: the frontend plays the original file, and switching it off deletes the streams.</p>

    {% if value.enabled and asset.id %}
        <div class="toolkit-streaming-row">
            {{ (status ?? pending).badgeHtml()|raw }}
            <button type="button" class="btn small toolkit-reprocess">Re-encode</button>
            <span class="toolkit-reprocess-message light" aria-live="polite"></span>
        </div>
    {% endif %}

    <div class="toolkit-poster" data-volume-uid="{{ volumeUid }}"{{ posterPending ? ' data-pending="1"' }}>
        <span class="toolkit-streaming-label">Poster</span>

        <div class="toolkit-poster-current">
            {% if posterThumbUrl %}
                <img src="{{ posterThumbUrl }}" alt="Current poster">
            {% else %}
                <span class="light">Extracted in the queue after saving.</span>
            {% endif %}
            <div>
                <p class="toolkit-poster-kind">
                    {%- if customPoster %}Custom image{% elseif poster %}Frame at {{ posterTime|number_format(1) }}s{% endif -%}
                </p>
                {% if asset.id %}
                    <div class="toolkit-streaming-row">
                        <label class="btn small">
                            Upload image
                            <input type="file" class="visually-hidden toolkit-poster-upload" accept="{{ extensions|map(e => '.' ~ e)|join(',') }}">
                        </label>
                        <button type="button" class="btn small toolkit-poster-choose">Choose from assets</button>
                        <button type="button" class="btn small toolkit-poster-reset" title="Back to the best moment of the video">Restore automatic</button>
                        <button type="button" class="btn small toolkit-poster-undo" hidden>Restore last</button>
                    </div>
                {% endif %}
                <p class="toolkit-poster-message light" aria-live="polite">
                    {{- posterPending ? 'The poster is being updated in the queue.' -}}
                </p>
            </div>
        </div>

        {# The poster change goes with the asset's Save: nothing changes until then #}
        <input type="hidden" class="toolkit-poster-time" name="{{ name }}[posterTime]" value="{{ value.posterTime }}">
        <input type="hidden" class="toolkit-poster-image" name="{{ name }}[posterImageId]" value="">
        <input type="hidden" class="toolkit-poster-reset-input" name="{{ name }}[resetPoster]" value="">

        <div class="toolkit-frame-picker" data-candidates="{{ candidates|json_encode }}" data-time="{{ posterTime }}" data-current-time="{{ poster and not customPoster ? posterTime }}">
            <span class="toolkit-streaming-label">Pick a frame</span>

            {% if url %}
                <div class="toolkit-frame-stage">
                    <video class="toolkit-frame-video" src="{{ url }}#t={{ posterTime }}" muted playsinline preload="auto"></video>
                </div>
                <input type="range" class="toolkit-frame-slider" min="0" max="{{ posterTime }}" step="0.1" value="{{ posterTime }}" aria-label="Frame, seconds into the video">
            {% endif %}

            <div class="toolkit-streaming-row">
                <input type="text" class="text toolkit-frame-timestamp" value="{{ posterTime }}" inputmode="decimal" aria-label="Timestamp, as 83.4 or 1:23.4" placeholder="0:00.0">
                {% if asset.id %}
                    <button type="button" class="btn submit toolkit-frame-use">Use this frame</button>
                {% endif %}
            </div>

            {% if url %}
                <div class="toolkit-frame-candidates" role="group" aria-label="Suggested moments"></div>
            {% endif %}
        </div>
        <p class="light toolkit-streaming-note">
            Move the slider, type a timestamp or click a suggested moment{{ candidates is null ? ' (found with the first poster)' }}, then <strong>Use this frame</strong>. Poster changes are applied when you save the asset.
        </p>
    </div>
</div>
